{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        metosin/malli {:mvn/version "0.20.3"}
        org.msgpack/msgpack-core {:mvn/version "0.9.12"}
        org.babashka/sci {:mvn/version "0.15.59"}
        ;; Desktop UI. Alpha and moving fast, so pinned to a commit.
        io.github.humbleui/humbleui {:git/url "https://github.com/HumbleUI/HumbleUI"
                                     :git/sha "ebb540a915420fc9d5c65fc6715424c6c2bbc6ab"}}
 :aliases
 {;; :jvm-opts below: msgpack-core still uses sun.misc.Unsafe, which JDK 24+ warns about.
  :test {:extra-paths ["test" "test/resources"]
         :jvm-opts ["--sun-misc-unsafe-memory-access=allow" "--enable-native-access=ALL-UNNAMED"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :nrepl {:extra-paths ["dev" "test" "test/resources"]
          :jvm-opts ["--sun-misc-unsafe-memory-access=allow" "--enable-native-access=ALL-UNNAMED"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                       org.clojure/tools.namespace {:mvn/version "1.5.1"}}
          :main-opts ["-m" "nrepl.cmdline"]}
  ;; The desktop app: window, engine, and an nREPL server for live coding.
  :ui {:extra-paths ["dev"]
       :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                    org.clojure/tools.namespace {:mvn/version "1.5.1"}}
       :jvm-opts ["--sun-misc-unsafe-memory-access=allow" "--enable-native-access=ALL-UNNAMED"]
       :main-opts ["-m" "gorilla.ui.main"]}}}
