{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        metosin/malli {:mvn/version "0.20.3"}
        org.msgpack/msgpack-core {:mvn/version "0.9.12"}}
 :aliases
 {;; :jvm-opts below: msgpack-core still uses sun.misc.Unsafe, which JDK 24+ warns about.
  :test {:extra-paths ["test"]
         :jvm-opts ["--sun-misc-unsafe-memory-access=allow"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :nrepl {:extra-paths ["dev" "test"]
          :jvm-opts ["--sun-misc-unsafe-memory-access=allow"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                       org.clojure/tools.namespace {:mvn/version "1.5.1"}}
          :main-opts ["-m" "nrepl.cmdline"]}}}
