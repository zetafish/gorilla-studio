{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gorilla Studio",
  "version": "0.1.0",
  "identifier": "dev.gorilla-studio.desktop",
  "build": {
    "frontendDist": "../../web/public",
    "devUrl": "http://localhost:8280",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../web", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../web" }
  },
  "app": {
    "windows": [
      { "title": "Gorilla Studio", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:7880 ws://localhost:7880 ws://localhost:9630; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
