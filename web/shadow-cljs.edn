;; The web UI. It shares gorilla.ui.model (and what it needs) with the brain,
;; straight from ../brain/src, so both UIs agree on what a click means.
{:source-paths ["src" "../brain/src"]
 :dependencies [[reagent "2.0.1"]
                [re-frame "1.4.7"]]
 :dev-http {8280 "public"}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn gorilla.web.app/init}}
                :devtools {:after-load gorilla.web.app/mount!}}}}
